{
  "name": "clipboard-football",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p packages/shared && tsc -p packages/shared/tsconfig.test.json && tsc -p packages/sim && tsc -p packages/sim/tsconfig.test.json && tsc -p tsconfig.tooling.json",
    "sim:game": "node --import ./scripts/engine/register.mjs scripts/game/sim-game.ts",
    "test:heavy": "vitest run --config vitest.heavy.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
