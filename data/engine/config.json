        "side": "defense",
        "id": "returnTeamIllegalBlock"
      },
      "Offensive Holding": {
        "note": "Designed (post-validation revision 9, M1 step 5): holding by the receiving team on a punt (pbp names every return-team hold 'Offensive Holding', charged to the receivers) is the rule set's return-team foul, 10 yards from the spot of the foul, like a block above the waist. Before, it was mapped to offensiveHolding and the engine emitted it against the kicking team. Kicking-team holding stays offensiveHolding.",
        "families": [
          "punt"
        ],
        "side": "defense",
        "id": "returnTeamIllegalBlock"
      }
