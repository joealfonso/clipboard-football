{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The UI runs in the browser. The worker shares this config and casts `self` to the few
    // worker members it uses, so the DOM and WebWorker libs don't clash.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
